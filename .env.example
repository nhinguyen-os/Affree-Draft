# Bật cache access token Co.op — tránh login lại mỗi lần, dùng token từ .coop_token_cache.json
# Đổi thành false để tắt (luôn login lại)
COOP_USE_TOKEN_CACHE=true
COOP_SKIP_LOGIN=false

# Tài khoản Co.op CỦA AFFREE (đặt hộ khách) — khi cấu hình, server đăng nhập Co.op bằng
# tài khoản này; khách KHÔNG cần mật khẩu/OTP (SĐT khách chỉ là liên hệ nhận hàng).
COOP_ACCOUNT_PHONE=
COOP_ACCOUNT_PASSWORD=

# ── Đăng nhập / Tài khoản người dùng (SĐT + OTP) ──
# Khoá ký HMAC cho OTP + cookie phiên. BẮT BUỘC đặt chuỗi ngẫu nhiên mạnh ở production.
AUTH_SECRET=
# Google Sheet chứa tab "Thông tin tài khoản" (mặc định đã hardcode; override nếu cần)
ACCOUNTS_SHEET_ID=1VLihAZ5pt96_g7s-Xosrcl0LCPkAh3UkdvsfnsbTUTY
# Thời hạn OTP tính bằng ms (mặc định 5 phút)
OTP_TTL_MS=300000
# Demo OTP: 1 = trả OTP về client để hiển thị (chưa có SMS). Đặt 0 khi đã ghép SMS thật.
OTP_DEMO_MODE=1

# Cấu hình WebSocket AI Agentic Server
NEXT_PUBLIC_ORDER_AGENT_SERVER_URL=ws://localhost:8080
# Token bảo mật để kết nối giữa client và agent server (để trống nếu không dùng)
ORDER_AGENT_SERVER_SECRET_TOKEN=123abc
# sử dụng agent modal của dev để tránh bị xung đột code
NEXT_PUBLIC_MODAL_DEV=true

# Dùng CoopOrderAgentModal (luồng Co.op thật) thay vì OrderAgentModal mô phỏng cho chain coop
NEXT_PUBLIC_COOP_REAL=true
