# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local agent/runtime artifacts
/.codex-runtime/
/.codex-runtime/**
.codex-runtime*/
.coop_token_cache.json
logs/
__pycache__/
scripts/__pycache__/

# paused BHX experiments/artifacts
app/api/bhx-agent/
integrations/bhx/
ss.html

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tạm bỏ qua khi push (PAT chưa có scope workflow) — thêm lại khi token có quyền
.github/workflows/scrape.yml
