# Gemini configuration
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Anthropic configuration
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Alibaba Cloud Qwen configuration
# QWEN_API_KEY=
# QWEN_MODEL=qwen3.5-flash
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# TXNN agentic loop toggle
# false = chỉ chạy CSS fallback playbook cho TXNN
# true  = cho phép TXNN chạy tiếp Agentic Tool-Use Loop sau bootstrap
RUN_TXNN_AGENTIC=false
 
QWEN_API_URL=
QWEN_MODEL=qwen3.5-omni-flash
QWEN_MODELS=qwen3.7-max,qwen3.7-max-2026-06-08,qwen3.7-plus,qwen3.7-plus-2026-05-26,qwen3.6-plus,qwen3.6-plus-2026-04-02,qwen3.6-flash,qwen3.6-35b-a3b,qwen3.6-27b,qwen3.5-omni-flash,qwen3.5-flash,qwen-plus,qwen-turbo,qwen-max,qvq-max,qvq-plus,qwen-vl-max,qwen-vl-plus,qwen-audio-turbo,qwen-tts,qwen3-embedding-8b,qwen3-embedding-4b,qwen3-embedding-0.6b,qwen3-reranker-8b,qwen3-reranker-4b,qwen3-reranker-0.6b
QWEN_API_KEY=

